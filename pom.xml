<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.3.0</version>
    </parent>

    <artifactId>uetlib-job</artifactId>
    <version>5.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <uetlib-core.version>2.2.2</uetlib-core.version>
        <uetlib-monitoring.version>2.2.2</uetlib-monitoring.version>
        <uetlib-db.version>2.0.1</uetlib-db.version>
        <uetlib-storage-spring-boot.version>2.0.2</uetlib-storage-spring-boot.version>
        <uetlib-spring-boot.version>2.1.0</uetlib-spring-boot.version>
    </properties>

    <dependencies>
        <!-- uetlib -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-core</artifactId>
            <version>${uetlib-core.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-monitoring</artifactId>
            <version>${uetlib-monitoring.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-db</artifactId>
            <version>${uetlib-db.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-storage-spring-boot</artifactId>
            <version>${uetlib-storage-spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-spring-boot</artifactId>
            <version>${uetlib-spring-boot.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-spring-boot-security</artifactId>
            <version>${uetlib-spring-boot.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
        </dependency>

        <!-- inotify-java -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>inotify</artifactId>
        </dependency>

        <!-- Command line args parsing -->
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
        </dependency>

        <!-- k8s client, needed for running high memory jobs on the cluster -->
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>joda-time</groupId>
                    <artifactId>joda-time</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- explicitly required by io.kubernetes:client-java when upgrading okhttp v4 to v5 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>

        <!-- Jobs need a database to store registered jobs, runs, logs, ... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Needed to interface with the native Postgres connection -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Websockets needed to send logs in real time to the status interface -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>stomp-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.websocket</groupId>
            <artifactId>jakarta.websocket-api</artifactId>
        </dependency>

        <!-- Additional utils for parsing and serializing time ranges -->
        <dependency>
            <groupId>net.time4j</groupId>
            <artifactId>time4j-base</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-test</artifactId>
            <version>2.0.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-mariadb</artifactId>
            <version>2.0.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-postgresql</artifactId>
            <version>2.0.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-mysql</artifactId>
            <version>2.0.1</version>
            <scope>test</scope>
        </dependency>

        <!-- DB Drivers -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>osgeo</id>
            <name>Open Source Geospatial Foundation Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <!-- All these Tests are run once per database, see executions below. -->
                                <!-- All other tests are run once, without a database -->
                                <exclude>**/*DatabaseTest.java</exclude>
                                <argLine>-Dspring.profiles.active=test,no-security</argLine>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>postgres-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>-Dspring.profiles.active=test,no-security,postgres</argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mysql-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>-Dspring.profiles.active=test,no-security,mysql</argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mariadb-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>-Dspring.profiles.active=test,no-security,mariadb</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/UbiqueInnovation/uetlib-job</url>
    </scm>
</project>