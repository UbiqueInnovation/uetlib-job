<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.uetlib</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>2026.11.1</version>
        <relativePath/>
    </parent>

    <artifactId>uetlib-job</artifactId>
    <version>8.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>uetlib-job</name>
    <description>Job scheduling, execution and monitoring infrastructure.</description>
    <url>https://github.com/UbiqueInnovation/uetlib-job</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <organization>
        <name>Ubique Innovation AG</name>
        <url>https://www.ubique.ch</url>
    </organization>
    <developers>
        <developer>
            <name>Ubique Innovation AG</name>
            <organization>Ubique Innovation AG</organization>
            <organizationUrl>https://www.ubique.ch</organizationUrl>
        </developer>
    </developers>

    <dependencies>
        <!-- uetlib -->
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-monitoring</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-db</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-storage-spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-spring-boot-security</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
        </dependency>

        <!-- inotify-java -->
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-inotify-java</artifactId>
        </dependency>

        <!-- Command line args parsing -->
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
        </dependency>

        <!-- k8s client, needed for running high memory jobs on the cluster -->
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>joda-time</groupId>
                    <artifactId>joda-time</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- explicitly required by io.kubernetes:client-java when upgrading okhttp v4 to v5 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
        </dependency>

        <!-- Jobs need a database to store registered jobs, runs, logs, ... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Needed to interface with the native Postgres connection -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Websockets needed to send logs in real time to the status interface -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>stomp-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.websocket</groupId>
            <artifactId>jakarta.websocket-api</artifactId>
        </dependency>

        <!-- Additional utils for parsing and serializing time ranges -->
        <dependency>
            <groupId>net.time4j</groupId>
            <artifactId>time4j-base</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-testcontainers-mariadb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.uetlib</groupId>
            <artifactId>uetlib-testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- DB Drivers -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-core</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-monitoring</artifactId>
                <version>3.0.2</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-db</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-inotify-java</artifactId>
                <version>3.0.3</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-storage-spring-boot</artifactId>
                <version>3.0.2</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-spring-boot</artifactId>
                <version>4.0.2</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-spring-boot-security</artifactId>
                <version>4.0.2</version>
            </dependency>

            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-test</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-testcontainers-mysql</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-testcontainers-postgresql</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>ch.uetlib</groupId>
                <artifactId>uetlib-testcontainers-mariadb</artifactId>
                <version>3.0.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.2.0</version>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <!-- All these Tests are run once per database, see executions below. -->
                                <!-- All other tests are run once, without a database -->
                                <exclude>**/*DatabaseTest.java</exclude>
                            </excludes>
                            <argLine>
                                @{argLine} -Dspring.profiles.active=test,no-security,job-primary-triggers,job-disable-triggers
                            </argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>postgres-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>
                                @{argLine} -Dspring.profiles.active=test,no-security,postgres,job-primary-triggers,job-disable-triggers
                            </argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mysql-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>
                                @{argLine} -Dspring.profiles.active=test,no-security,mysql,job-primary-triggers,job-disable-triggers
                            </argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mariadb-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>
                                @{argLine} -Dspring.profiles.active=test,no-security,mariadb,job-primary-triggers,job-disable-triggers
                            </argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>4.2.0</version>
                    <executions>
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>



    <scm child.scm.url.inherit.append.path="false" child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false">
        <connection>scm:git:https://github.com/UbiqueInnovation/uetlib-job.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/UbiqueInnovation/uetlib-job.git</developerConnection>
        <url>https://github.com/UbiqueInnovation/uetlib-job</url>
    </scm>
</project>
