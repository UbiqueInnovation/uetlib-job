<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.ubique</groupId>
        <artifactId>uetlib-parent</artifactId>
        <version>1.1.3</version>
    </parent>

    <artifactId>uetlib-job</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <ch.ubique.uetlib.testcontainers.version>1.0.0</ch.ubique.uetlib.testcontainers.version>

        <!-- Sonar-->
        <sonar.projectName>uetlib-job</sonar.projectName>
        <sonar.coverage.module>uetlib-job</sonar.coverage.module>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-storage-spring-boot</artifactId>
            <version>1.1.3</version>
        </dependency>

        <!-- Monitoring -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-monitoring</artifactId>
            <version>1.0.1</version>
        </dependency>

        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-spring-boot-security</artifactId>
            <version>1.1.2</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-db</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- inotify-java -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>inotify</artifactId>
            <version>2.0</version>
        </dependency>

        <!-- Command line args parsing -->
        <dependency>
            <groupId>commons-cli</groupId>
            <artifactId>commons-cli</artifactId>
        </dependency>

        <!-- k8s client, needed for running high memory jobs on the cluster -->
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>joda-time</groupId>
                    <artifactId>joda-time</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jobs need a database, to store registered jobs, runs, logs, ... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Websockets, needed to send logs in real time to status interface -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>stomp-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.websocket</groupId>
            <artifactId>jakarta.websocket-api</artifactId>
        </dependency>

        <!-- Additional utils for parsing and serializing time ranges -->
        <dependency>
            <groupId>net.time4j</groupId>
            <artifactId>time4j-base</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback.db</groupId>
            <artifactId>logback-classic-db</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-test</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-mariadb</artifactId>
            <version>${ch.ubique.uetlib.testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-postgresql</artifactId>
            <version>${ch.ubique.uetlib.testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.ubique</groupId>
            <artifactId>uetlib-testcontainers-mysql</artifactId>
            <version>${ch.ubique.uetlib.testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- DB Drivers -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <!-- All these Tests are run once per database, see executions below. -->
                                <!-- All other tests are run once, without a database -->
                                <exclude>**/*DatabaseTest.java</exclude>
                                <argLine>-Dspring.profiles.active=test</argLine>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>postgres-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>-Dspring.profiles.active=test,postgres</argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mysql-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>-Dspring.profiles.active=test,mysql</argLine>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mariadb-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*DatabaseTest.java</include>
                            </includes>
                            <argLine>-Dspring.profiles.active=test,mariadb</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Plugin to allow lazy-fetching an entity attribute using @Basic(fetch = FetchType.LAZY) -->
            <plugin>
                <groupId>org.hibernate.orm.tooling</groupId>
                <artifactId>hibernate-enhance-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <configuration>
                            <failOnError>true</failOnError>
                            <enableLazyInitialization>true</enableLazyInitialization>
                        </configuration>
                        <goals>
                            <goal>enhance</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>